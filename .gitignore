.DS_Store
tt.*
.tests
doc/tags
debug
.repro
foo.*
*.log
data

.gemini-api-key

# Local-only zsh customizations dropped into zshrc.local.d/ stay on the
# machine they were written on. README is the only tracked file there.
zshrc.local.d/*
!zshrc.local.d/README.md

# Agent skills are fetched from upstream at install time, pinned by
# agents/skills.json. The fetched copies are ephemeral and not tracked.
agents/skills/

# Local-only skills bucket: drop a skill folder into agents/skills-local/ to
# use it on this machine without committing it. Only .gitkeep is tracked.
agents/skills-local/*
!agents/skills-local/.gitkeep
